# Скопируйте в .env при необходимости. Все переменные необязательны.
PORT=8080
# Если не задан — генерируется при первом запуске и хранится в томе данных
JWT_SECRET=
# Демо-линия производства (автоматическое продвижение статусов): 1/0
DEMO_SIMULATOR=1
# Ключи внешних моделей (или введите в админке → AI-шлюз)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Telegram-бот статусов заказа (или введите в админке → Настройки → Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
